# `make init` creates .env with unique passwords. These are placeholders only.
SCHEWISE_ORIGIN=https://localhost:8443
PUBLIC_BASE_URL=https://localhost:8443
SCHEWISE_INVITE_TTL=168h
SCHEWISE_ADMIN_EMAIL=admin@example.test
SCHEWISE_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SCHEWISE_SESSION_TTL=24h
SCHEWISE_STORE_SESSION_IP=true
SCHEWISE_PASSWORD_RESET_TTL=24h
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=schewise
PGUSER=schewise
PGPASSWORD=replace-with-a-unique-application-database-password
POSTGRES_PASSWORD=replace-with-a-different-postgres-bootstrap-password

# Generate once: openssl rand -base64 32. Preserve this key with metadata backups.
SCHEWISE_SECRET_KEY=replace-with-base64-encoded-32-byte-key
SCHEWISE_STATEMENT_TIMEOUT=30s
# Comma-separated exact hostnames, IPs, or CIDRs. Deny takes precedence.
SCHEWISE_CONNECTION_HOST_ALLOW=
SCHEWISE_CONNECTION_HOST_DENY=
# Synthetic demo server only; never use these credentials outside local fixtures.
DEMO_POSTGRES_PASSWORD=replace-with-a-unique-demo-bootstrap-password
DEMO_DATABASE_PASSWORD=replace-with-a-different-demo-reader-password
# Native API: 127.0.0.1:5433. API inside Compose: demo-db:5432.
SCHEWISE_DEMO_HOST=127.0.0.1
SCHEWISE_DEMO_PORT=5433
